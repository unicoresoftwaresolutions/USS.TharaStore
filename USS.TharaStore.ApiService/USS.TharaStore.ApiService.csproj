<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Enable OpenAPI source generator interceptors namespace to avoid CS9137 -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="UnicoreSoftwareSolutions.Base.APIService" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\USS.TharaStore.Business\USS.TharaStore.Business.csproj" />
    <ProjectReference Include="..\USS.TharaStore.Data\USS.TharaStore.Data.csproj" />
    <ProjectReference Include="..\USS.TharaStore.ServiceDefaults\USS.TharaStore.ServiceDefaults.csproj" />
  </ItemGroup>



</Project>
